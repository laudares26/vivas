DATABASE_URL=postgresql://postgres:password@localhost:5432/vivas
PORT=3001
NODE_ENV=development

# LLM provider for the Vivi assistant and exam analysis.
# "groq" (default) uses Groq/Llama; "vertex" (or "medgemma") uses MedGemma
# (Google Health AI) via Vertex AI. If the selected provider is not fully
# configured, the app falls back to Groq (and then to the deterministic
# safety-net narrative).
LLM_PROVIDER=groq

# Groq LLM (used when LLM_PROVIDER=groq, and as fallback)
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# MedGemma via Vertex AI (used when LLM_PROVIDER=vertex).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MEDGEMMA_MODEL=medgemma
# Provide EITHER a dedicated endpoint id (model deployed from Model Garden)...
VERTEX_MEDGEMMA_ENDPOINT_ID=
# ...OR a full OpenAI-compatible chat/completions URL (overrides the endpoint id).
VERTEX_MEDGEMMA_URL=
# Auth — provide the service-account JSON key inline (preferred on Fly)...
GOOGLE_VERTEX_SA_KEY=
# ...OR point to a key file (standard Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=

# Transactional email — SMTP provider for the vivas.digital domain (e.g. Brevo).
# When unset, emails are logged to the console instead of being sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Platform sender address (single source of truth)
SMTP_FROM="vivas" <contato@vivas.digital>
# Recipient for B2B lead notifications
LEADS_NOTIFY_EMAIL=contato@vivas.digital
